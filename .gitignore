# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# Conserver les migrations Django dans Git ; ignorer uniquement leurs caches.
**/migrations/__pycache__/

# ── Django ───────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py
.env
.env.*

# Collected static files (manage.py collectstatic)
staticfiles/
static_root/

# Media files uploaded by users — do NOT commit user data or large binaries
media/

# Security Auditor local scan history and credentials
.security-audits/
security_auditor/requirements_overrides.yml

# Local temporary/test artifacts
tmp/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.freebuff/
*.swp
*~

# Local connection credentials: never commit private keys or SSH configuration.
.ssh/
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
id_dsa

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
