# A inserer UNIQUEMENT dans le site HTTPS dedie a creation.abservesmart.com.
# DNS, certificat TLS et configuration du site sont a preparer sur le VPS.
# Remplacer l'upstream ci-dessous par le port/socket reel du Django staging.
# Reference: https://nginx.org/en/docs/http/ngx_http_proxy_module.html#proxy_pass

server_name creation.abservesmart.com;

location ~ "^/creer-compte/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(sections/|creer/)?$" {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host creation.abservesmart.com;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_cache off;
}

location / {
    return 404;
}
